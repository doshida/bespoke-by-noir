---
import Layout from '../layouts/Layout.astro';
import { rich } from '../lib/text.js';
import d from '../data/commissions.json';
---
<Layout title={d.seo.title} description={d.seo.description} active="commissions.html">

<section class="phead wrap">
  <span class="eyebrow reveal">{d.header.eyebrow}</span>
  <h1 class="h-xl phead__title reveal" data-d="1" set:html={rich(d.header.title)}></h1>
  <p class="phead__sub reveal" data-d="2">{d.header.sub}</p>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="filters reveal" role="group" aria-label="Filter commissions">
      {d.filters.map((f, i) => (
        <button data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
      ))}
    </div>

    <div class="gallery reveal" data-d="1">
      {d.items.map((it) => (
        <figure data-occ={it.occasionKey}>
          <img class={it.tone ? 'tone-noir' : undefined} src={it.image} alt={it.imageAlt}>
          <figcaption><div class="g-occ">{it.occasionLabel}</div><div class="g-t" set:html={rich(it.title)}></div></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="section cta-band" style="padding-top:0">
  <div class="wrap center">
    <span class="eyebrow center reveal">{d.cta.eyebrow}</span>
    <h2 class="display reveal mt-s" style="font-size:clamp(2.2rem,5.5vw,4.4rem)" set:html={rich(d.cta.heading)}></h2>
    <div class="reveal mt-l" data-d="1"><a class="btn btn--solid" href={d.cta.buttonHref}><span>{d.cta.buttonLabel}</span></a></div>
  </div>
</section>

</Layout>
