---
import Layout from '../layouts/Layout.astro';
import { rich } from '../lib/text.js';
import d from '../data/home.json';
---
<Layout title={d.seo.title} description={d.seo.description} active="">

<!-- Hero -->
<header class="hero">
  <div class="hero__bg"><img src={d.hero.image} alt={d.hero.imageAlt}></div>
  <div class="hero__inner wrap">
    <span class="eyebrow reveal">{d.hero.eyebrow}</span>
    <h1 class="display hero__title reveal" data-d="1" set:html={rich(d.hero.title)}></h1>
    <p class="hero__sub reveal" data-d="2">{d.hero.sub}</p>
    <div class="hero__cta reveal" data-d="3">
      <a class="btn btn--solid" href={d.hero.ctaPrimaryHref}><span>{d.hero.ctaPrimaryLabel}</span></a>
      <a class="txtlink" href={d.hero.ctaSecondaryHref}>{d.hero.ctaSecondaryLabel}</a>
    </div>
  </div>
  <div class="scrollcue">Scroll</div>
</header>

<!-- The Invitation -->
<section class="section" id="invitation">
  <div class="wrap split split--wideL">
    <div class="split__media split__media--tall reveal">
      <img src={d.invitation.image} alt={d.invitation.imageAlt}>
      <span class="figtag">{d.invitation.figtag}</span>
    </div>
    <div>
      <span class="eyebrow reveal">{d.invitation.eyebrow}</span>
      <p class="lead reveal mt-m" data-d="1">{d.invitation.lead}</p>
      <p class="muted reveal mt-m" data-d="2">{d.invitation.body}</p>
      <a class="txtlink reveal mt-l" data-d="3" href={d.invitation.linkHref}>{d.invitation.linkLabel}</a>
    </div>
  </div>
</section>

<hr class="rule">

<!-- The Ritual -->
<section class="section" id="ritual">
  <div class="wrap">
    <div class="center" style="margin-bottom:clamp(2.5rem,6vh,4.5rem)">
      <span class="eyebrow center reveal">{d.ritual.eyebrow}</span>
      <h2 class="h-xl reveal mt-s" data-d="1">{d.ritual.heading}</h2>
    </div>
    <div class="ritual">
      {d.ritual.acts.map((act, i) => (
        <a class="act reveal" data-d={i > 0 ? String(i) : undefined} href={act.href || d.ritual.buttonHref}>
          <div class="act__media"><img src={act.image} alt={act.imageAlt}></div>
          <div class="act__no">{act.number}</div>
          <div class="act__t">{act.title}</div>
          <p class="act__d">{act.desc}</p>
        </a>
      ))}
    </div>
    <div class="center mt-l reveal"><a class="btn" href={d.ritual.buttonHref}><span>{d.ritual.buttonLabel}</span></a></div>
  </div>
</section>

<!-- The Atelier band -->
<section class="section band" id="atelier">
  <div class="wrap split">
    <div>
      <span class="eyebrow reveal">{d.atelierBand.eyebrow}</span>
      <h2 class="h-xl reveal mt-s" data-d="1" set:html={rich(d.atelierBand.heading)}></h2>
      <p class="muted reveal mt-m maxw" data-d="2">{d.atelierBand.body}</p>
      <div style="display:flex;gap:2.5rem;align-items:center;margin-top:2.5rem" class="reveal" data-d="3">
        <div class="seal" set:html={rich(d.atelierBand.sealText)}></div>
        <div>
          <p class="meta">{d.atelierBand.locationLabel}</p>
          <p class="lead" style="font-size:1.3rem;margin:.3rem 0">{d.atelierBand.location}</p>
          <a class="txtlink" href={d.atelierBand.linkHref}>{d.atelierBand.linkLabel}</a>
        </div>
      </div>
    </div>
    <div class="split__media split__media--tall reveal" data-d="1">
      <img src={d.atelierBand.image} alt={d.atelierBand.imageAlt}>
    </div>
  </div>
</section>

<!-- For the boardroom (C-suite) -->
<section class="section" id="distinction">
  <div class="wrap split">
    <div class="split__media split__media--tall reveal">
      <img src={d.distinction.image} alt={d.distinction.imageAlt}>
      <span class="figtag">{d.distinction.figtag}</span>
    </div>
    <div>
      <span class="eyebrow reveal">{d.distinction.eyebrow}</span>
      <h2 class="h-xl reveal mt-s" data-d="1" set:html={rich(d.distinction.heading)}></h2>
      <p class="muted reveal mt-m maxw" data-d="2">{d.distinction.body}</p>
      <ul class="reveal mt-m" data-d="2" style="list-style:none;padding:0;margin:1.6rem 0 0;color:var(--bone-2)">
        {d.distinction.bullets.map((b, i) => (
          <li style={`padding:.7rem 0;border-top:1px solid var(--line)${i === d.distinction.bullets.length - 1 ? ';border-bottom:1px solid var(--line)' : ''}`}>{b}</li>
        ))}
      </ul>
      <a class="txtlink reveal mt-l" data-d="3" href={d.distinction.linkHref}>{d.distinction.linkLabel}</a>
    </div>
  </div>
</section>

<!-- Recent Commissions -->
<section class="section commissions" id="commissions">
  <div class="wrap" style="display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap;margin-bottom:2.5rem">
    <div>
      <span class="eyebrow reveal">{d.commissions.eyebrow}</span>
      <h2 class="h-xl reveal mt-s" data-d="1" set:html={rich(d.commissions.heading)}></h2>
    </div>
    <a class="txtlink reveal" data-d="2" href={d.commissions.linkHref}>{d.commissions.linkLabel}</a>
  </div>
  <div class="hscroll">
    {d.commissions.cards.map((card, i) => (
      <a class="card reveal" data-d={i > 0 ? String(i) : undefined} href={card.href || d.commissions.linkHref}>
        <div class="card__media"><img class={card.tone ? 'tone-noir' : undefined} src={card.image} alt={card.imageAlt}></div>
        <div class="card__body">
          <div class="card__occ">{card.occasion}</div>
          <div class="card__t" set:html={rich(card.title)}></div>
          <div class="card__cloth">{card.cloth}</div>
        </div>
      </a>
    ))}
  </div>
</section>

<hr class="rule">

<!-- Testimonials -->
<section class="section" id="voices">
  <div class="wrap">
    <div class="quote" data-quotes={JSON.stringify(d.testimonials.map((t) => ({ t: t.quote, by: t.by })))}>
      <span class="quote__mark">&ldquo;</span>
      <p class="quote__t reveal">&nbsp;</p>
      <p class="quote__by reveal" data-d="1"></p>
      <div class="quote__dots" role="tablist" aria-label="Testimonials"></div>
    </div>
  </div>
</section>

<!-- Closing CTA -->
<section class="section cta-band">
  <div class="cta-band__bg"><img src={d.cta.image} alt=""></div>
  <div class="wrap center">
    <span class="eyebrow center reveal">{d.cta.eyebrow}</span>
    <h2 class="display reveal mt-s" data-d="1" style="font-size:clamp(2.4rem,6vw,5rem)" set:html={rich(d.cta.heading)}></h2>
    <p class="muted reveal mt-m" data-d="2" style="max-width:44ch;margin-inline:auto">{d.cta.sub}</p>
    <div class="reveal mt-l" data-d="3"><a class="btn btn--solid" href={d.cta.buttonHref}><span>{d.cta.buttonLabel}</span></a></div>
  </div>
</section>

</Layout>
