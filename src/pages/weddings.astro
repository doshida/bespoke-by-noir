---
import Layout from '../layouts/Layout.astro';
import { rich } from '../lib/text.js';
import d from '../data/weddings.json';
---
<Layout title={d.seo.title} description={d.seo.description} active="weddings.html" theme="light">

<!-- Hero -->
<header class="hero">
  <div class="hero__bg"><img src={d.hero.image} alt={d.hero.imageAlt}></div>
  <div class="hero__inner wrap">
    <span class="eyebrow reveal">{d.hero.eyebrow}</span>
    <h1 class="display hero__title reveal" data-d="1" set:html={rich(d.hero.title)}></h1>
    <p class="hero__sub reveal" data-d="2">{d.hero.sub}</p>
    <div class="hero__cta reveal" data-d="3">
      <a class="btn btn--solid" href={d.hero.ctaPrimaryHref}><span>{d.hero.ctaPrimaryLabel}</span></a>
      <a class="txtlink" href={d.hero.ctaSecondaryHref}>{d.hero.ctaSecondaryLabel}</a>
    </div>
  </div>
  <div class="scrollcue">Scroll</div>
</header>

<!-- The Invitation -->
<section class="section" id="invitation">
  <div class="wrap split split--wideL">
    <div class="split__media split__media--tall reveal">
      <img src={d.invitation.image} alt={d.invitation.imageAlt}>
      <span class="figtag">{d.invitation.figtag}</span>
    </div>
    <div>
      <span class="eyebrow reveal">{d.invitation.eyebrow}</span>
      <p class="lead reveal mt-m" data-d="1">{d.invitation.lead}</p>
      <p class="muted reveal mt-m" data-d="2">{d.invitation.body}</p>
      <a class="txtlink reveal mt-l" data-d="3" href={d.invitation.linkHref}>{d.invitation.linkLabel}</a>
    </div>
  </div>
</section>

<hr class="rule">

<!-- Offerings -->
<section class="section" id="offerings">
  <div class="wrap">
    <div class="center" style="margin-bottom:clamp(2.5rem,6vh,4.5rem)">
      <span class="eyebrow center reveal">{d.offerings.eyebrow}</span>
      <h2 class="h-xl reveal mt-s" data-d="1" set:html={rich(d.offerings.heading)}></h2>
    </div>
    <div class="ritual">
      {d.offerings.items.map((o, i) => (
        <a class="act reveal" data-d={i > 0 ? String(i) : undefined} href={o.href}>
          <div class="act__media"><img src={o.image} alt={o.imageAlt}></div>
          <div class="act__no">{o.number}</div>
          <div class="act__t offer__t">{o.title}</div>
          <p class="act__d">{o.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- The Process -->
<section class="section band" id="process">
  <div class="wrap">
    <div class="center" style="margin-bottom:clamp(2.5rem,6vh,4rem)">
      <span class="eyebrow center reveal">{d.process.eyebrow}</span>
      <h2 class="h-xl reveal mt-s" data-d="1" set:html={rich(d.process.heading)}></h2>
      <p class="muted reveal mt-m" data-d="2" style="max-width:48ch;margin-inline:auto">{d.process.sub}</p>
    </div>
    <div class="steps reveal" data-d="1">
      {d.process.steps.map((s) => (
        <div class="step"><div class="step__no">{s.number}</div><div><div class="step__t">{s.title}</div><p class="step__d">{s.desc}</p></div></div>
      ))}
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="section" id="gallery">
  <div class="wrap">
    <div class="center" style="margin-bottom:clamp(2rem,5vh,3.5rem)">
      <span class="eyebrow center reveal">{d.gallery.eyebrow}</span>
      <h2 class="h-xl reveal mt-s" data-d="1">{d.gallery.heading}</h2>
    </div>
    <div class="gallery reveal" data-d="1">
      {d.gallery.items.map((g) => (
        <figure><img src={g.image} alt={g.imageAlt}><figcaption><div class="g-occ">{g.occasionLabel}</div><div class="g-t">{g.title}</div></figcaption></figure>
      ))}
    </div>
  </div>
</section>

<hr class="rule">

<!-- Testimonials -->
<section class="section" id="voices">
  <div class="wrap">
    <div class="quote" data-quotes={JSON.stringify(d.testimonials.map((t) => ({ t: t.quote, by: t.by })))}>
      <span class="quote__mark">&ldquo;</span>
      <p class="quote__t reveal">&nbsp;</p>
      <p class="quote__by reveal" data-d="1"></p>
      <div class="quote__dots" role="tablist" aria-label="Testimonials"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section cta-band">
  <div class="cta-band__bg"><img src={d.cta.image} alt=""></div>
  <div class="wrap center">
    <span class="eyebrow center reveal">{d.cta.eyebrow}</span>
    <h2 class="display reveal mt-s" data-d="1" style="font-size:clamp(2.4rem,6vw,5rem)" set:html={rich(d.cta.heading)}></h2>
    <p class="muted reveal mt-m" data-d="2" style="max-width:46ch;margin-inline:auto">{d.cta.sub}</p>
    <div class="reveal mt-l" data-d="3"><a class="btn btn--solid" href={d.cta.buttonHref}><span>{d.cta.buttonLabel}</span></a></div>
  </div>
</section>

</Layout>
