---
import Layout from '../layouts/Layout.astro';
import { rich } from '../lib/text.js';
import d from '../data/appointment.json';
---
<Layout title={d.seo.title} description={d.seo.description} active="appointment.html" navSolid={true}>

<main class="apply">
  <aside class="apply__aside">
    <img src={d.aside.image} alt={d.aside.imageAlt}>
    <div class="apply__aside-in">
      <span class="eyebrow">{d.aside.eyebrow}</span>
      <p class="lead mt-s" style="max-width:22ch">{d.aside.lead}</p>
    </div>
  </aside>

  <section class="apply__form">
    <form class="form" novalidate>
      <div class="form__body">
        <span class="eyebrow reveal">{d.form.eyebrow}</span>
        <h1 class="h-xl reveal mt-s" data-d="1" set:html={rich(d.form.title)}></h1>
        <p class="reassure reveal" data-d="2">{d.form.reassurance}</p>

        <div class="field reveal">
          <label for="name">Your Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required>
        </div>

        <div class="field2">
          <div class="field reveal">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="field reveal">
            <label for="phone">Preferred Contact / Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel">
          </div>
        </div>

        <div class="field2">
          <div class="field reveal">
            <label for="occasion">The Occasion</label>
            <select id="occasion" name="occasion" required>
              <option value="" selected disabled>Select an occasion</option>
              {d.form.occasions.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field reveal">
            <label for="date">Preferred Date</label>
            <input id="date" name="date" type="date">
          </div>
        </div>

        <div class="field reveal">
          <label for="story">Tell Us About the Occasion</label>
          <textarea id="story" name="story" placeholder="A few words on what you have in mind…"></textarea>
        </div>

        <button class="btn btn--solid reveal" type="submit" style="margin-top:.6rem"><span>{d.form.submitLabel}</span></button>
        <p class="meta reveal" style="margin-top:1.6rem">{d.form.disclaimer}</p>
      </div>

      <div class="confirm">
        <span class="quote__mark" style="font-size:3rem">&#10003;</span>
        <h2 class="h-lg" style="margin-top:1rem">{d.confirm.heading}</h2>
        <p class="muted mt-m" style="max-width:40ch">{d.confirm.body}</p>
        <a class="txtlink mt-l" href="index.html" style="display:inline-block">{d.confirm.linkLabel}</a>
      </div>
    </form>
  </section>
</main>

</Layout>
