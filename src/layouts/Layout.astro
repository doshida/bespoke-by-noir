---
import site from '../data/site.json';

const {
  title,
  description,
  active = '',          // href of the current page, to mark the nav link active
  theme = 'dark',       // 'dark' | 'light'
  navSolid = false,     // start the nav in its solid state (e.g. appointment page)
} = Astro.props;

const bodyClass = theme === 'light' ? 'theme-light' : '';
const navClass = navSolid ? 'nav solid' : 'nav';
const blurbHtml = site.footer.blurb.replace(/\n/g, '<br>');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/noir.css">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230E0D0B'/%3E%3Ctext x='16' y='23' font-family='Georgia,serif' font-size='20' fill='%23C9A96A' text-anchor='middle'%3EN%3C/text%3E%3C/svg%3E">
</head>
<body class={bodyClass}>
<!-- Page-transition curtain -->
<div class="curtain" aria-hidden="true">
  <div class="curtain__in">
    <img class="curtain__fig" src="assets/img/silhouette-tailor.png" alt="">
    <span class="curtain__mark">{site.brand}</span>
  </div>
</div>

<nav class={navClass} aria-label="Primary">
  <a class="nav__brand" href="index.html"><b>{site.brand.charAt(0)}</b>{site.brand.slice(1)}</a>
  <button class="nav__toggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
  <div class="nav__links">
    {site.nav.map((item) => (
      <a href={item.href} class={active === item.href ? 'active' : undefined}>{item.label}</a>
    ))}
    <a class="btn nav__cta" href={site.cta.href}><span>{site.cta.label}</span></a>
  </div>
</nav>

<slot />

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <div class="footer__brand"><b>{site.brand.charAt(0)}</b>{site.brand.slice(1)}</div>
        <p class="maxw" set:html={blurbHtml}></p>
      </div>
      <div>
        <h5>{site.footer.houseHeading}</h5>
        {site.nav.map((item, i) => (
          <>{i > 0 && <br />}<a href={item.href}>{item.label}</a></>
        ))}
      </div>
      <div>
        <h5>{site.footer.commissionHeading}</h5>
        <a href={site.cta.href}>{site.cta.label}</a><br>
        <a href={`mailto:${site.footer.email}`}>{site.footer.email}</a><br>
        <a href={site.footer.instagram} aria-label="Instagram">Instagram</a>
      </div>
    </div>
    <div class="footer__bottom">
      <span>{site.footer.copyright}</span>
      <span><a href="#">Privacy</a> &nbsp;·&nbsp; <a href="#">Terms</a></span>
    </div>
  </div>
</footer>

<script src="js/noir.js" is:inline></script>
</body>
</html>
